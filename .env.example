# Local development values only. Change the password before exposing PostgreSQL.
POSTGRES_DB=photo_search
POSTGRES_USER=photo_search
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# The app connects from your computer to the published Docker port.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=photo_search
DB_USER=photo_search
DB_PASSWORD=change-this-local-password

# These are intentionally the same for a simple local setup.
CLIP_MODEL_ID=openai/clip-vit-base-patch32
IMAGE_DIR=data/images
MAX_UPLOAD_MB=20
